{
  "name": "amateras-monorepo",
  "author": {
    "name": "defaultkavy",
    "email": "defaultkavy@gmail.com",
    "url": "https://github.com/defaultkavy"
  },
  "module": "index.ts",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "esbuild": "^0.28.2",
    "terser": "^5.51.2",
    "typescript": "^7.1.0-dev.20261105.1",
    "vite": "^8.3.6"
  },
  "bugs": {
    "url": "https://github.com/defaultkavy/amateras/issues"
  },
  "description": "Amateras is a JavaScript library for building user interface.",
  "files": [
    "index.ts",
    "tsconfig.json",
    "build"
  ],
  "homepage": "https://github.com/defaultkavy/amateras",
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "tag": "beta"
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "size": "bun ./scripts/vite-bundler-size.ts",
    "publish": "bun ./scripts/publish.ts",
    "link": "for dir in packages/*/; do (cd \"$dir\" && bun link); done",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf {} + && rm -f bun.lock bun.lockb && bun install",
    "change": "bunx changeset add -m update",
    "version": "bunx changeset version && bun i",
    "release": "bun run change && bun run version && bun run build && bun run publish"
  },
  "type": "module",
  "unpkg": "./build/import-map.js",
  "workspaces": [
    "packages/*",
    "libs/*"
  ]
}
